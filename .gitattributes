# Git attributes para consistencia de line endings
* text=auto eol=lf

# Archivos específicos
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows CMD interpreta mal los .bat con solo LF (comandos truncados: "hcp", "etlocal", etc.)
*.bat text eol=crlf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
