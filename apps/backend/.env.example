# ============================================================
# Panel Ejecutivo Waze - Backend - Variables de entorno
# Copiar a .env y completar los valores reales.
# NUNCA subir .env al control de versiones.
# ============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Zona horaria del proceso Node.js — garantiza hora local argentina en logs y cálculos
TZ=America/Argentina/Buenos_Aires

# URL del frontend (para CORS). En producción usa la IP/dominio real.
# Dejar en blanco o "*" para permitir cualquier origen (no recomendado en prod).
FRONTEND_URL=http://10.1.0.136:5180

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=panel_waze
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
# Máximo de conexiones en el pool (default: 25). Con 66 polígonos + clima + TVT, valores altos saturan.
# Si hay "timeout exceeded when trying to connect", reducir a 20-25.
DB_POOL_MAX=25

# ------------------------------------------------------------
# Redis (opcional - el backend opera sin Redis)
# En Windows Server se puede usar Memurai: https://www.memurai.com/
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ------------------------------------------------------------
# Autenticación JWT
# Cambiar JWT_SECRET por una cadena larga y aleatoria en producción.
# ------------------------------------------------------------
JWT_SECRET=panel-waze-secret-key-CAMBIA-EN-PRODUCCION
JWT_EXPIRATION=8h

# ------------------------------------------------------------
# Clima
# Proveedor: openmeteo (gratuito, sin clave) | accuweather
# ------------------------------------------------------------
WEATHER_PROVIDER=openmeteo
# Solo si WEATHER_PROVIDER=accuweather:
# ACCUWEATHER_API_KEY=

# URL base de Open-Meteo (raramente hay que cambiarla)
# OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------
# Fuentes de tráfico externas (opcionales)
# Mejoran la precisión de la información de incidentes.
# ------------------------------------------------------------
# HERE_API_KEY=
# TOMTOM_API_KEY=

# ------------------------------------------------------------
# Risk scoring (Dashboard de Riesgos / KPIs por grupo)
# Desactivado por defecto en main/preprod. Activar solo en group-kpis-display:
# ENABLE_RISK_SCORING=1
# ------------------------------------------------------------
# ENABLE_RISK_SCORING=

# ------------------------------------------------------------
# Waze
# ------------------------------------------------------------
# Token para el proxy de íconos de Waze (si el feed requiere autenticación)
# WAZE_FEED_TOKEN=
# WAZE_PARTNER_ID=

# ------------------------------------------------------------
# Logging
# Niveles: trace | debug | info | warn | error | fatal
# ------------------------------------------------------------
LOG_LEVEL=info
